---
import type { Project } from '../data/projects';
import { sitePath } from '../utils/site';

interface Props {
  project: Project;
  compact?: boolean;
}

const { project, compact = false } = Astro.props;
const previewVideos: Record<string, string> = {
  fetaui: 'fetaui-showcase',
  billdr: 'billdr-voice-tasks',
  otera: 'otera-ai-coworker',
  nexscale: 'nexscale-cinematic',
  qpage: 'qpage-intro',
  weldica: 'weldica-walkthrough'
};
const previewVideo = previewVideos[project.slug];
const previewImage = project.slug === 'chloe' ? sitePath('poulo-assets/chloe-preview.webp') : undefined;
const coverImage = project.coverImage ? sitePath(project.coverImage) : undefined;
---
<div class:list={['project-cover', `cover-${project.accent}`, `cover-${project.slug}`, { compact }]} style={coverImage ? `--cover-image: url('${coverImage}')` : undefined} aria-hidden="true">
  <div class="cover-topline"><span>{project.index}</span><span>{project.tags[0]}</span></div>
  {(previewVideo || previewImage) && <div class="cover-video-frame"><div class="cover-video-placeholder">{previewVideo && <video aria-label={`${project.title} preview`} muted playsinline loop preload="none" src={`https://www.poulo.site/videos/${previewVideo}.mp4`} poster={sitePath(`poulo-assets/posters/${previewVideo}.jpg`)}></video>}{previewImage && <img src={previewImage} alt="" />}</div></div>}
  {compact && <div class="cover-prompt"><span>Ask anything about this project...</span><b>↗</b></div>}
  {project.accent === 'coral' && (
    <div class="cover-network">
      <span class="cover-node node-a"></span><span class="cover-node node-b"></span><span class="cover-node node-c"></span>
      <span class="cover-line line-a"></span><span class="cover-line line-b"></span><span class="cover-line line-c"></span>
    </div>
  )}
  {project.accent === 'yellow' && (
    <div class="cover-console"><span class="console-bar"></span><span class="console-bar short"></span><span class="console-chart"></span><span class="console-dot"></span></div>
  )}
  {project.accent === 'blue' && (
    <div class="cover-notes"><span></span><span></span><span></span><span></span><b>NOTE<br />/ 03</b></div>
  )}
  <div class="cover-bottomline"><strong>{project.title}</strong><span>{project.year}</span></div>
</div>
