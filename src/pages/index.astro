---
import BaseLayout from '../components/BaseLayout.astro';
import ProjectCover from '../components/ProjectCover.astro';
import Portrait from '../components/Portrait.astro';
import { projects } from '../data/projects';
import { experiments } from '../data/experiments';
import { projectPath, sitePath } from '../utils/site';

const workFilters = ['All', 'AI and Agentics', 'Websites', 'SaaS', 'Mobile App', 'Design System'];
const stackItems = [
  ['Figma', 'figma'], ['Sketch', 'sketch'], ['Adobe', 'adobe'], ['Notion', 'notion'], ['ClickUp', 'clickup'], ['Slack', 'slack'],
  ['Miro', 'miro'], ['Claude', 'claude'], ['OpenAI', 'openai'], ['Maze', 'maze'], ['Google Antigravity', 'antigravity'], ['Cursor', 'cursor'],
  ['GitHub', 'github'], ['GitLab', 'gitlab'], ['Storybook', 'storybook'], ['Vercel', 'vercel'], ['Framer', 'framer'], ['Webflow', 'webflow'],
  ['Shopify', 'shopify'], ['Supabase', 'supabase'], ['Cloudflare', 'cloudflare'], ['Mixpanel', 'mixpanel'], ['Google Analytics', 'google-analytics'], ['Power BI', 'power-bi'],
  ['Tableau', 'tableau'], ['Zapier', 'zapier'], ['Google Tag Manager', 'google-tag-manager'], ['Mailchimp', 'mailchimp'], ['Intercom', 'intercom'], ['Stripe', 'stripe']
] as const;
const pouloVideoBase = 'https://www.poulo.site/videos/';
const experimentVideos = ['turntable-ad', 'ai-components-package', 'mock-hiring-assessment-teaser'] as const;
---

<BaseLayout title="Kain Yin — Product designer and builder">
  <section class="home-hero" aria-labelledby="hero-title">
    <div class="container home-hero-inner">
      <div class="home-hero-copy">
        <p class="eyebrow">Technical product designer</p>
        <h1 id="hero-title"><span class="sr-only">Technical Product Designer, Seasoned UX Designer, Experienced Product Manager, AI Product Builder</span><span aria-hidden="true" class="hero-title-desktop"><span>Seasoned UX</span><span>Designer</span></span><span aria-hidden="true" class="hero-title-tablet">Experienced Product<br />Manager</span><span aria-hidden="true" class="hero-title-mobile">AI Product<br />Builder</span></h1>
        <p class="home-hero-description">从用户问题、产品结构到可用界面和真实代码，把复杂想法变成可以被理解、使用和继续成长的产品。</p>
        <div class="hero-actions">
          <a class="button secondary" href="#about">About me <span aria-hidden="true">↓</span></a>
          <a class="button primary" href="#work">See my work <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="hero-avatar" aria-label="Portrait illustration that looks toward your cursor">
        <Portrait />
      </div>
      <div class="hero-note">
        <button class="hero-trigger hero-about-trigger" type="button" data-hero-chat data-message="Technical PM by trade, User interface and experience Designer by necessity | Shipping user-centric products from problem/concept to code" aria-expanded="false">Hi, I’m Pouya</button>
        <div class="hero-chat" data-hero-chat-panel hidden role="status" aria-live="polite"></div>
        <button class="hero-trigger" type="button" data-hero-chat data-message="我会把研究、结构、交互和代码放在同一个工作流里。" aria-expanded="false">I design and build interfaces</button>
        <p>Craft AI and SaaS products (Mobile, Desktop, and Web) from the pulse of user needs to the forefront of technology.</p>
        <button class="hero-trigger" type="button" data-hero-chat data-message="产品设计和前端工程一起工作，能让决策更快被验证。" aria-expanded="false">Product design and front-end engineering</button>
      </div>
    </div>
  </section>

  <section class="logo-strip" aria-label="Areas of practice">
    <div class="container logo-strip-inner">
      <h2>Led impactful initiatives at</h2>
      <div class="logo-strip-items" aria-hidden="true">
        <img src={sitePath('poulo-assets/logo-07.png')} alt="" /><img src={sitePath('poulo-assets/logo-04.png')} alt="" /><img src={sitePath('poulo-assets/logo-06.png')} alt="" /><img src={sitePath('poulo-assets/logo-08.png')} alt="" /><img src={sitePath('poulo-assets/logo-05.png')} alt="" /><img src={sitePath('poulo-assets/logo-03.png')} alt="" /><img src={sitePath('poulo-assets/logo-02.png')} alt="" /><img src={sitePath('poulo-assets/logo-01.png')} alt="" />
      </div>
    </div>
  </section>

  <section class="home-section interface-section" aria-labelledby="interface-title">
    <div class="container">
      <h2 id="interface-title">Designed components and products directly rooted in user discovery, bridging raw customer insights with intuitive UI/UX and core functional requirements.</h2>
      <section class="interface-gallery" aria-label="Selected work">
        <article class="interface-card interface-receipt"><span>01 / Receipt printer</span><h3>Feta Coffee</h3><div class="receipt-lines"></div><strong>$18.58</strong></article>
        <article class="interface-card interface-gauge"><span>02 / Liquid gauge</span><h3>Storage</h3><div class="gauge-ring">72%</div><small>35.8 GB free</small></article>
        <article class="interface-card interface-code"><span>03 / OTP vault</span><h3>Enter the code</h3><strong>••••••••</strong><small>Paste your code to continue</small></article>
        <article class="interface-card interface-chart"><span>04 / Line forecast</span><h3>At this pace you reach the budget on Sep 26</h3><div class="forecast-line"></div></article>
        <article class="interface-card interface-bars"><span>05 / Daily activity</span><h3>ACME · Daily</h3><div class="activity-bars"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div><small>Agent view</small></article>
      </section>
    </div>
  </section>

  <section class="home-section work-section" id="work" aria-labelledby="work-title">
    <div class="container">
      <div class="section-heading work-heading">
        <div><p class="eyebrow">Selected work</p><h2 id="work-title">Works.</h2></div>
        <p class="work-count" data-work-count>Showing {projects.length} of {projects.length} projects</p>
      </div>
      <div class="work-controls">
        <div class="work-filters" role="radiogroup" aria-label="Filter work">
          {workFilters.map((filter, index) => <button type="button" class:list={{ active: index === 0 }} data-filter={filter} role="radio" aria-checked={index === 0}>{filter}<span>{index === 0 ? projects.length : projects.filter((project) => project.tags.includes(filter)).length}</span></button>)}
        </div>
        <div class="view-switcher" role="radiogroup" aria-label="Change work view">
          <button type="button" class="active" data-view="showcase" role="radio" aria-checked="true">Showcase</button>
          <button type="button" data-view="grid" role="radio" aria-checked="false">Grid</button>
          <button type="button" data-view="deck" role="radio" aria-checked="false">Deck</button>
        </div>
      </div>
      <div class="case-list" data-case-list>
        {projects.map((project) => (
          <article class="case-card" data-case-card data-tags={project.tags.join('|')}>
            <header class="case-card-header">
              <div><p class="eyebrow">{project.eyebrow}</p><h3>{project.slug === 'fetaui' ? <>fetaUI. An animated design system<br />that agents can read.</> : <>{project.title}{project.headingJoin ?? '. '}{project.description}</>}</h3><ul class="case-tags">{project.tags.map((tag) => <li>{tag}</li>)}</ul></div>
              <span class="case-year">{project.year}</span>
            </header>
            <div class="case-card-main">
              <a class="case-card-media" href={projectPath(project.slug)} aria-label={`Learn more about ${project.title}`}><ProjectCover project={project} compact /></a>
              <div class="case-card-summary">
                <p>{project.summary}</p>
                <dl><div><dt>Role</dt><dd>{project.role}</dd></div><div><dt>Team</dt><dd>{project.team}</dd></div></dl>
                <a class="learn-link" href={projectPath(project.slug)}>Learn more <span aria-hidden="true">↗</span></a>
              </div>
            </div>
            <ul class="case-insights">
              {project.sections.slice(0, 4).map((section, index) => <li class="insight-card"><span>{String(index + 1).padStart(2, '0')}</span><h4>{section.title}</h4><p>{section.paragraphs[0]}</p></li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="home-section experiments-section" id="experiments" aria-labelledby="experiments-title">
    <div class="container">
      <div class="section-heading"><div><p class="eyebrow">Small things, shipped often</p><h2 id="experiments-title">AI Experiments</h2></div><a href={sitePath('experiments/')}>View all ↗</a></div>
      <div class="experiments-grid">
        {experiments.map((experiment, index) => <article class="experiment-card"><div class="experiment-preview"><video aria-label={experiment.title} muted playsinline loop preload="none" src={`${pouloVideoBase}${experimentVideos[index]}.mp4`} poster={sitePath(`poulo-assets/posters/${experimentVideos[index]}.jpg`)}></video><span>{String(index + 1).padStart(2, '0')}</span><i></i><i></i></div><p class="eyebrow">{experiment.type} · {experiment.status}</p><h3>{experiment.title}</h3><p>{experiment.description}</p><a class="learn-link" href={experiment.href}>Give it a try <span aria-hidden="true">↗</span></a></article>)}
      </div>
    </div>
  </section>

  <section class="home-section about-section" id="about" aria-labelledby="about-title">
    <div class="container">
      <h2 class="about-kicker">Ask me anything...</h2>
      <div class="about-grid">
        <div><p class="eyebrow">About me</p><h3 id="about-title">I also code, speak in English and French, play soccer and volleyball.</h3></div>
        <div class="about-copy">
          <p>I’m Pouya aka poulo (pronounced p-ou-l-o), a product manager with background in business and software engineering who fell in love with design. I’ve learned to design, build and test ideas quickly.</p>
          <p>Outside of work, I tinker with AI tools like Claude mostly with Antigravity/Cursor to create small productivity experiments. Away from the screen, you’ll find me cooking, playing football, or watching a game.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="home-section journey-section" aria-labelledby="journey-title">
    <div class="container">
      <div class="section-heading"><div><p class="eyebrow">Journey</p><h3 id="journey-title">Journey</h3></div></div>
      <ul class="journey-table">
        <li><strong>Lead Product Designer and Product Strategist</strong><span>Freelancer</span><span>Vancouver - Montreal</span><span>2025-Now</span></li>
        <li><strong>Founding Product Designer</strong><span>Deepopinion</span><span>Innsbruck, Austria</span><span>2023-25</span></li>
        <li><strong>Cofounder, CPO</strong><span>QPage</span><span>London, UK</span><span>2021-23</span></li>
        <li><strong>UX Product Manager</strong><span>Zalando</span><span>Berlin, Germany</span><span>2019-21</span></li>
        <li><strong>Masters in Marketing</strong><span>Aalto school of business</span><span>Helsinki, Finland</span><span>2015-17</span></li>
        <li><strong>Managing Director</strong><span>Rocket Internet</span><span>Dubai, UAE</span><span>2017-19</span></li>
        <li><strong>Cofounder, Product</strong><span>Reyhoon</span><span>Tehran, Iran</span><span>2016-17</span></li>
        <li><strong>Senior Product Manager</strong><span>LG Electronics</span><span>Dubai, UAE</span><span>2009-2016</span></li>
      </ul>
    </div>
  </section>

  <section class="home-section stack-section" id="stack" aria-labelledby="stack-title">
    <div class="container stack-grid"><div><p class="eyebrow">My Stack</p><h3 id="stack-title">My Stack</h3></div><div class="stack-items">{stackItems.map(([name, file]) => <span><img src={sitePath(`poulo-assets/stack/${file}.svg`)} alt={name} /></span>)}</div></div>
  </section>

  <section class="home-section contact-section" id="contact" aria-label="Contact"></section>
</BaseLayout>

<script>
  const cards = [...document.querySelectorAll<HTMLElement>('[data-case-card]')];
  const filterButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const viewButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-view]')];
  const list = document.querySelector('[data-case-list]');
  const count = document.querySelector('[data-work-count]');
  function setFilter(filter: string) {
    let visible = 0;
    cards.forEach((card) => { const matches = filter === 'All' || card.dataset.tags?.split('|').includes(filter); card.hidden = !matches; if (matches) visible += 1; });
    filterButtons.forEach((button) => { const active = button.dataset.filter === filter; button.classList.toggle('active', active); button.setAttribute('aria-checked', String(active)); });
    if (count) count.textContent = `Showing ${visible} of ${cards.length} projects`;
  }
  filterButtons.forEach((button) => button.addEventListener('click', () => setFilter(button.dataset.filter || 'All')));
  viewButtons.forEach((button) => button.addEventListener('click', () => { viewButtons.forEach((item) => { const active = item === button; item.classList.toggle('active', active); item.setAttribute('aria-checked', String(active)); }); list?.setAttribute('data-view', button.dataset.view || 'showcase'); }));
  const chatTriggers = [...document.querySelectorAll<HTMLButtonElement>('[data-hero-chat]')];
  const chatPanel = document.querySelector<HTMLElement>('[data-hero-chat-panel]');
  const syncHeroStates = () => {
    const [aboutTrigger, designTrigger, engineeringTrigger] = chatTriggers;
    if (aboutTrigger) {
      aboutTrigger.setAttribute('aria-expanded', 'false');
    }
    if (designTrigger) {
      designTrigger.setAttribute('aria-expanded', 'false');
    }
    if (engineeringTrigger) {
      engineeringTrigger.setAttribute('aria-expanded', 'false');
    }
  };
  syncHeroStates();
  window.matchMedia('(max-width: 800px)').addEventListener('change', syncHeroStates);
  chatTriggers.forEach((trigger) => trigger.addEventListener('click', () => {
    const isOpen = trigger.getAttribute('aria-expanded') === 'true';
    chatTriggers.forEach((item) => item.setAttribute('aria-expanded', String(item === trigger && !isOpen)));
    if (chatPanel) {
      chatPanel.hidden = isOpen;
      chatPanel.textContent = isOpen ? '' : trigger.dataset.message || '';
    }
  }));
  const portrait = document.querySelector<SVGElement>('.hero-portrait svg');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (portrait && !reduceMotion) {
    const heroAvatar = document.querySelector<HTMLElement>('.hero-avatar');
    heroAvatar?.addEventListener('pointermove', (event) => {
      const bounds = heroAvatar.getBoundingClientRect();
      const look = Math.max(-1, Math.min(1, (event.clientX - (bounds.left + bounds.width / 2)) / (bounds.width / 2)));
      portrait.style.setProperty('--look', look.toFixed(4));
    });
    heroAvatar?.addEventListener('pointerleave', () => portrait.style.setProperty('--look', '0'));
    window.setInterval(() => {
      portrait.style.setProperty('--blink', '0');
      window.setTimeout(() => portrait.style.setProperty('--blink', '1'), 120);
    }, 4200);
  }
</script>
