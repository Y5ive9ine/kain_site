---
import BaseLayout from '../components/BaseLayout.astro';
import ProjectCover from '../components/ProjectCover.astro';
import { projects } from '../data/projects';
import { experiments } from '../data/experiments';
import { sitePath } from '../utils/site';

const workFilters = ['All', 'Research', 'Systems', 'SaaS', 'Publishing'];
const stackItems = ['Product strategy', 'User research', 'Interaction design', 'Design systems', 'React', 'TypeScript', 'Astro', 'Prototyping', 'AI workflows', 'Front-end engineering'];
---

<BaseLayout title="Kain Yin — Product designer and builder">
  <section class="home-hero" aria-labelledby="hero-title">
    <div class="container home-hero-inner">
      <div class="home-hero-copy">
        <p class="eyebrow">Technical product designer</p>
        <h1 id="hero-title">I design and build <span>useful systems.</span></h1>
        <p class="home-hero-description">从用户问题、产品结构到可用界面和真实代码，把复杂想法变成可以被理解、使用和继续成长的产品。</p>
        <div class="hero-actions">
          <a class="button secondary" href="#about">About me <span aria-hidden="true">↓</span></a>
          <a class="button primary" href="#work">See my work <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="hero-avatar" aria-label="Abstract illustrated portrait of Kain">
        <div class="hero-avatar-orbit orbit-one"></div>
        <div class="hero-avatar-orbit orbit-two"></div>
        <div class="avatar-hair"></div>
        <div class="avatar-ear avatar-ear-left"></div>
        <div class="avatar-ear avatar-ear-right"></div>
        <div class="avatar-face"><i class="avatar-eye avatar-eye-left"></i><i class="avatar-eye avatar-eye-right"></i><b class="avatar-nose"></b><b class="avatar-mouth"></b></div>
        <div class="avatar-neck"></div>
        <div class="avatar-body"><span>K / 26</span></div>
        <div class="avatar-spark spark-one"></div><div class="avatar-spark spark-two"></div>
      </div>
      <div class="hero-note">
        <p class="eyebrow">Hi, I’m Kain</p>
        <p>我在产品、设计系统和 AI 工具之间工作，喜欢把模糊问题整理成可以继续行动的界面。</p>
        <button class="hero-trigger" type="button" data-hero-chat data-message="我会把研究、结构、交互和代码放在同一个工作流里。" aria-expanded="false">I design and build interfaces <span aria-hidden="true">↗</span></button>
        <p>从用户发现到真实交付，让每一步都更容易理解和继续。</p>
        <button class="hero-trigger" type="button" data-hero-chat data-message="产品设计和前端工程一起工作，能让决策更快被验证。" aria-expanded="false">Product design and front-end engineering <span aria-hidden="true">↗</span></button>
        <div class="hero-chat" data-hero-chat-panel hidden role="status" aria-live="polite"></div>
      </div>
    </div>
  </section>

  <section class="logo-strip" aria-label="Areas of practice">
    <div class="container logo-strip-inner">
      <span>Led by curiosity</span>
      <div class="logo-strip-items" aria-hidden="true">
        <b>UX</b><b>AI</b><b>UI</b><b>PM</b><b>WEB</b><b>SYS</b><b>UX</b><b>AI</b>
      </div>
    </div>
  </section>

  <section class="home-section interface-section" aria-labelledby="interface-title">
    <div class="container">
      <p class="eyebrow">Interface studies</p>
      <h2 id="interface-title">Designed from user discovery, shaped into calm interfaces.</h2>
      <div class="interface-gallery" aria-label="Interface study previews">
        <article class="interface-card interface-receipt"><span>01 / Receipt printer</span><div class="receipt-lines"></div><strong>$18.58</strong></article>
        <article class="interface-card interface-gauge"><span>02 / Liquid gauge</span><div class="gauge-ring">72%</div><small>35.8 GB free</small></article>
        <article class="interface-card interface-code"><span>03 / OTP vault</span><strong>••••••••</strong><small>Paste your code to continue</small></article>
        <article class="interface-card interface-chart"><span>04 / Line forecast</span><div class="forecast-line"></div></article>
        <article class="interface-card interface-bars"><span>05 / Daily activity</span><div class="activity-bars"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div></article>
      </div>
    </div>
  </section>

  <section class="home-section work-section" id="work" aria-labelledby="work-title">
    <div class="container">
      <div class="section-heading work-heading">
        <div><p class="eyebrow">Selected work</p><h2 id="work-title">Works.</h2></div>
        <p class="work-count" data-work-count>Showing {projects.length} of {projects.length} projects</p>
      </div>
      <div class="work-controls">
        <div class="work-filters" role="radiogroup" aria-label="Filter work">
          {workFilters.map((filter, index) => <button type="button" class:list={{ active: index === 0 }} data-filter={filter} role="radio" aria-checked={index === 0}>{filter}<span>{index === 0 ? projects.length : projects.filter((project) => project.tags.includes(filter)).length}</span></button>)}
        </div>
        <div class="view-switcher" role="radiogroup" aria-label="Change work view">
          <button type="button" class="active" data-view="showcase" role="radio" aria-checked="true">Showcase</button>
          <button type="button" data-view="grid" role="radio" aria-checked="false">Grid</button>
          <button type="button" data-view="deck" role="radio" aria-checked="false">Deck</button>
        </div>
      </div>
      <div class="case-list" data-case-list>
        {projects.map((project) => (
          <article class="case-card" data-case-card data-tags={project.tags.join('|')}>
            <div class="case-card-header">
              <div><p class="eyebrow">{project.tags.join(' · ')}</p><h3>{project.title}. {project.description}</h3></div>
              <span class="case-year">{project.year}</span>
            </div>
            <div class="case-card-main">
              <a class="case-card-media" href={sitePath(`work/${project.slug}/`)} aria-label={`Learn more about ${project.title}`}><ProjectCover project={project} compact /></a>
              <div class="case-card-summary">
                <p>{project.summary}</p>
                <dl><div><dt>Role</dt><dd>{project.role}</dd></div><div><dt>Team</dt><dd>{project.team}</dd></div></dl>
                <a class="learn-link" href={sitePath(`work/${project.slug}/`)}>Learn more <span aria-hidden="true">↗</span></a>
              </div>
            </div>
            <div class="case-insights">
              {project.sections.map((section, index) => <div class="insight-card"><span>{String(index + 1).padStart(2, '0')}</span><strong>{section.title}</strong><p>{section.paragraphs[0]}</p></div>)}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="home-section experiments-section" id="experiments" aria-labelledby="experiments-title">
    <div class="container">
      <div class="section-heading"><div><p class="eyebrow">Small things, shipped often</p><h2 id="experiments-title">AI experiments.</h2></div><a href={sitePath('experiments/')}>View all ↗</a></div>
      <div class="experiments-grid">
        {experiments.map((experiment, index) => <article class="experiment-card"><div class="experiment-preview"><span>{String(index + 1).padStart(2, '0')}</span><i></i><i></i></div><p class="eyebrow">{experiment.type} · {experiment.status}</p><h3>{experiment.title}</h3><p>{experiment.description}</p><a class="learn-link" href={experiment.href}>Give it a try <span aria-hidden="true">↗</span></a></article>)}
      </div>
    </div>
  </section>

  <section class="home-section about-section" id="about" aria-labelledby="about-title">
    <div class="container">
      <p class="eyebrow">Ask me anything...</p>
      <div class="about-grid">
        <div><p class="eyebrow">About me</p><h2 id="about-title">I also code, speak in English and Chinese, and keep making things.</h2></div>
        <div class="about-copy">
          <p>我是 Kain，一名关注产品策略、交互设计和前端实现的产品设计师。我喜欢从模糊的问题开始，做出足够清晰的结构，再把它交付到真实的使用场景。</p>
          <details open><summary>Hi, I’m Kain</summary><p>我在产品、设计系统和 AI 工具之间工作，也维护一个记录判断、实验和当前状态的个人网站。</p></details>
          <details><summary>I design and build interfaces</summary><p>从研究和信息架构，到组件、内容和前端，我会把整条体验链路放在一起考虑。</p></details>
          <details><summary>Product design and front-end engineering</summary><p>我用可维护的内容模型、设计令牌和原生交互把设计变成可以继续迭代的产品。</p></details>
        </div>
      </div>
    </div>
  </section>

  <section class="home-section journey-section" aria-labelledby="journey-title">
    <div class="container">
      <div class="section-heading"><div><p class="eyebrow">Journey</p><h2 id="journey-title">A few useful chapters.</h2></div></div>
      <div class="journey-table"><div><strong>Product designer and builder</strong><span>Independent</span><span>Asia</span><span>2024 — now</span></div><div><strong>Design systems and AI workflows</strong><span>Selected projects</span><span>Remote</span><span>2022 — 24</span></div><div><strong>Product strategy and interaction</strong><span>Digital products</span><span>China</span><span>2019 — 22</span></div></div>
    </div>
  </section>

  <section class="home-section stack-section" id="stack" aria-labelledby="stack-title">
    <div class="container stack-grid"><div><p class="eyebrow">My stack</p><h2 id="stack-title">Tools are useful when they make the next decision clearer.</h2></div><div class="stack-items">{stackItems.map((item) => <span>{item}</span>)}</div></div>
  </section>

  <section class="home-section contact-section" id="contact" aria-labelledby="contact-title">
    <div class="container contact-inner"><div><p class="eyebrow">Have a question?</p><h2 id="contact-title">Let’s make something <span>clearer.</span></h2></div><a class="button primary" href="mailto:hello@example.com">hello@example.com <span aria-hidden="true">↗</span></a></div>
  </section>
</BaseLayout>

<script>
  const cards = [...document.querySelectorAll<HTMLElement>('[data-case-card]')];
  const filterButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const viewButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-view]')];
  const list = document.querySelector('[data-case-list]');
  const count = document.querySelector('[data-work-count]');
  function setFilter(filter: string) {
    let visible = 0;
    cards.forEach((card) => { const matches = filter === 'All' || card.dataset.tags?.split('|').includes(filter); card.hidden = !matches; if (matches) visible += 1; });
    filterButtons.forEach((button) => { const active = button.dataset.filter === filter; button.classList.toggle('active', active); button.setAttribute('aria-checked', String(active)); });
    if (count) count.textContent = `Showing ${visible} of ${cards.length} projects`;
  }
  filterButtons.forEach((button) => button.addEventListener('click', () => setFilter(button.dataset.filter || 'All')));
  viewButtons.forEach((button) => button.addEventListener('click', () => { viewButtons.forEach((item) => { const active = item === button; item.classList.toggle('active', active); item.setAttribute('aria-checked', String(active)); }); list?.setAttribute('data-view', button.dataset.view || 'showcase'); }));
  const chatTriggers = [...document.querySelectorAll<HTMLButtonElement>('[data-hero-chat]')];
  const chatPanel = document.querySelector<HTMLElement>('[data-hero-chat-panel]');
  chatTriggers.forEach((trigger) => trigger.addEventListener('click', () => {
    const isOpen = trigger.getAttribute('aria-expanded') === 'true';
    chatTriggers.forEach((item) => item.setAttribute('aria-expanded', String(item === trigger && !isOpen)));
    if (chatPanel) {
      chatPanel.hidden = isOpen;
      chatPanel.textContent = isOpen ? '' : trigger.dataset.message || '';
    }
  }));
</script>
